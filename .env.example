# Required. Get via https://app.speak-up.pro/settings/mcp ("Generate token").
# Plaintext shown once at create-time; keep it secret.
SPEAKUP_MCP_TOKEN=sk_speakup_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional override. Default: https://api.speak-up.pro/v2/mcp/transport/
# Point at staging while testing: https://api-staging.speakup.ltd/v2/mcp/transport/
# SPEAKUP_MCP_URL=

# Optional. Enables stderr DEBUG-level lines (request payload previews, masked).
# SPEAKUP_MCP_DEBUG=1
